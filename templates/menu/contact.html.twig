{% extends 'base.html.twig' %}

{% block title %}Accueil
{% endblock %}

{% block body %}
	<style>
		body {
			width: 100%;
			margin: 0;
		}

		.contact-section {
			max-width: 1114px;
			margin-left: auto;
			margin-right: auto;
			margin-top: 2rem;
			display: flex;
			align-items: end;
			background-color: #fff;
			padding-block: 100px;
			align-items: center;
			gap: 6rem;

		}

		.contact-image {
			padding-right: 20px;
		}

		.contact-image img {

			width: 100%;
			border-radius: 5px;
			opacity: 0.8;
		}

		.contact-form {
			flex: 2;
		}

		.contact-form h4 {
			color: #1A3F6D;
			font-size: 2rem;
			font-weight: 600;
			margin-bottom: 30px;
		}

		.contact-form p {
			font-size: 1rem;
			margin-bottom: 40px;
			font-weight: 600;
			color: #333;
		}

		.contact-form p a {
			color: rgb(0, 212, 0);
			font-size: 20px;
		}
		form {
			padding: 20px;
			background-color: #f5f9ff;
			border-radius: 8px;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
		}

		.form-row {
			display: flex;
			gap: 20px;
			margin-bottom: 20px;
		}

		.form-group {
			flex: 1;
		}

		.form-group label {
			display: block;
			margin-bottom: 5px;
			font-weight: bold;
		}

		.form-group input,
		.form-group textarea {
			width: 100%;
			padding: 10px;
			border: none;
			border-radius: 4px;
			font-size: 1rem;
		}

		.form-group textarea {
			resize: vertical;
			min-height: 100px;
		}

		button[type="submit"] {
			display: inline-block;
			background-color: #1a2c5b;
			color: #fff;
			padding: 10px 20px;
			border: none;
			border-radius: 4px;
			font-size: 1rem;
			cursor: pointer;
		}

		button[type="submit"]:hover {
			background-color: #163f9b;
		}
	</style>

	<div class="contact-section">
		<div class="contact-image">
			<img src="Images/coup-moyen-homme-reparant-articles-mode_23-2150627997-removebg-preview.png" alt="Contact Image">
		</div>
		<div class="contact-form">
			<h4>Contactez nous!</h4>
			<p>Vous avez des questions ou besoin d'aide ? Contactez-nous via le formulaire ci-dessous ou via
				<a href="https://wa.me/+22994454646">WhatsApp</a>.</p>
			{{ form_start(form) }}
			<div class="form-row">
				<div class="form-group">
					{{ form_label(form.name) }}
					{{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
				</div>
				<div class="form-group">
					{{ form_label(form.email) }}
					{{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
				</div>
			</div>
			<div class="form-group">
				{{ form_label(form.message) }}
				{{ form_widget(form.message, {'attr': {'class': 'form-control'}}) }}
			</div>
			{{ form_widget(form.submit, {'attr': {'class': 'btn btn-primary'}}) }}
			{{ form_end(form) }}
		</div>
	</div>
	{% for message in app.flashes('success') %}
		<div class="alert alert-success">
			{{ message }}
		</div>
	{% endfor %}

{% endblock %}
