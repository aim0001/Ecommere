	<script>


		function toggleSubcategories(element) {
const accountMenuList = element.nextElementSibling;
if (accountMenuList.style.display === "none" || accountMenuList.style.display === "") {
accountMenuList.style.display = "block";
} else {
accountMenuList.style.display = "none";
}
}


document.addEventListener('DOMContentLoaded', function () {
initBurgerMenu(); // Initialisation du burger menu quand la page est chargée
});

document.addEventListener('turbo:load', function () {
initBurgerMenu();
});


function initBurgerMenu() {

const burgerMenuButton = document.querySelector('.menu-icon')
const burgerMenuButtonIcon = document.querySelector('.menu-icon i')
const burgerMenu = document.querySelector('.burger_menu')
if (burgerMenuButton) {
burgerMenuButton.onclick = function () {
burgerMenu.classList.toggle('open')
const isOpen = burgerMenu.classList.contains('open')
burgerMenuButtonIcon.classList = isOpen ? 'fa-solid fa-xmark' : 'fa-solid fa-bars'
};
}

}


document.addEventListener('DOMContentLoaded', function () {
const menuIcon = document.querySelector('.menu-icon');
const menu = document.querySelector('.menu');

menuIcon.addEventListener('click', function () {
menu.classList.toggle('show');
});

const logoutLink = document.querySelector('a.logout-link');
if (logoutLink) {
logoutLink.addEventListener('click', function () {
localStorage.removeItem('productStates');
localStorage.removeItem('cartCount');
});
}

// Assume the login link has a class 'login-link' or similar
const loginLink = document.querySelector('a.login-link');
if (loginLink) {
loginLink.addEventListener('click', function () {
localStorage.removeItem('productStates');
localStorage.removeItem('cartCount');
});
}
});

function OpenCloseMenu(clickedElement) {
var menuItem = clickedElement.nextElementSibling;

if (menuItem.style.display === 'block') {
menuItem.style.display = 'none';
} else {
menuItem.style.display = 'block';
}
}

function toggleAccountMenu() {
const accountToggle = document.querySelector('.toggle-account-menu');
const accountMenu = document.querySelector('.account-menu');

accountToggle.addEventListener('click', function () {
accountMenu.classList.toggle('active');
});

window.addEventListener('click', function (event) {
if (! accountToggle.contains(event.target) && ! accountMenu.contains(event.target)) {
accountMenu.classList.remove('active');
}
});

accountMenu.addEventListener('click', function (event) {
event.stopPropagation();
});
}

document.addEventListener('DOMContentLoaded', function () {
toggleAccountMenu();
});

document.addEventListener('DOMContentLoaded', function () {
const logoutLink = document.querySelector('a.logout-link');
if (logoutLink) {
logoutLink.addEventListener('click', function () {
localStorage.removeItem('productStates');
});
}
});

document.addEventListener('DOMContentLoaded', function () {
const menuIcon = document.querySelector('.menu-icon');
const menu = document.querySelector('.menu');

menuIcon.addEventListener('click', function () {
menu.classList.toggle('show');
});
});
	</script>
